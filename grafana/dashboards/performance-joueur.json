{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 30,
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "expr": "sum by (cause) (origin_cause_build:perf_reports:rate5m{origin=~\"$origin\"}) * 60",
          "legendFormat": "{{cause}}",
          "refId": "A"
        }
      ],
      "title": "Combien de rapports de saccade reçoit-on par minute, par cause ?",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "expr": "sum by (build) (origin_cause_build:perf_reports:rate5m{origin=~\"$origin\"}) * 60",
          "legendFormat": "{{build}}",
          "refId": "A"
        }
      ],
      "title": "Quel build génère le plus de rapports de saccade par minute ?",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "id": 3,
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(perf_report_frame_seconds_bucket{origin=~\"$origin\"}[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(perf_report_frame_seconds_bucket{origin=~\"$origin\"}[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "title": "Combien de temps durent les images trop lentes (p50, p95) ?",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "id": 4,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        },
        "pieType": "donut",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum by (cause) (increase(perf_reports_total{origin=~\"$origin\"}[$__range]))",
          "instant": true,
          "legendFormat": "{{cause}}",
          "refId": "A"
        }
      ],
      "title": "Quelle part des rapports vient de chaque cause sur la période ?",
      "type": "piechart"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "orange",
                "value": 20
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "id": 5,
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [],
          "values": true
        }
      },
      "targets": [
        {
          "expr": "sum by (ecran) (count_over_time({source=\"live\"} | json | event=\"perf_spike\" | report_work_details_renderOverlay > 100 | label_format ecran=\"{{.report_graphics_width}} px\" [$__range]))",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Quelles largeurs d'écran sont touchées par les saccades d'overlay ?",
      "type": "bargauge"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "id": 6,
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [],
          "values": true
        }
      },
      "targets": [
        {
          "expr": "sum by (navigateur) (count_over_time({source=\"live\"} | json | event=\"perf_spike\" | label_format navigateur=`{{ regexReplaceAll \" ·.*\" .report_browser \"\" }}` [$__range]))",
          "legendFormat": "{{navigateur}}",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Quels navigateurs envoient le plus de rapports de saccade ?",
      "type": "bargauge"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 42,
  "tags": [
    "ue03"
  ],
  "templating": {
    "list": [
      {
        "current": {
